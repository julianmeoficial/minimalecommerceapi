NODE_ENV=development
PORT=8080

DATABASE_URL=postgresql://app:change-me@localhost:5432/minimalecommerce?schema=public
REDIS_URL=redis://localhost:6379

# Usa JWT_KEYS (kid:secreto,...) o JWT_SECRET (mín. 32 caracteres)
JWT_SECRET=change-me-to-a-long-random-secret-key-32-chars-min
# JWT_KEYS=activa:secreto-de-al-menos-32-caracteres,anterior:otro-secreto-largo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=7

CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=usd
PAGOS_TIMEOUT_MS=5000
RESERVA_MINUTOS=15
CONCILIACION_MINUTOS=10
TRABAJOS_PROGRAMADOS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# local | supabase (supabase requiere bucket + service_role; obligatorio en production)
MEDIA_DRIVER=local
UPLOAD_DIR=../../.data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
MEDIA_URL_TTL_SEGUNDOS=3600

SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MinimalShop <no-reply@minimalshop.local>
