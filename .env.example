NODE_ENV=development
PORT=8080

# Postgres — local O Supabase (Settings → Database → Connection string → URI)
# Copia este .env también a apps/api/.env (Prisma lo lee ahí)
DATABASE_URL=postgresql://app:change-me@localhost:5432/minimalecommerce?schema=public

JWT_SECRET=change-me-to-a-long-random-secret-key-32
JWT_EXPIRES_IN=1d
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# TLS local (Safari + Swagger). Tras `pnpm certs:dev` se activa solo si existen los .pem
# TLS_ENABLED=true
# TLS_KEY_PATH=apps/api/certs/localhost-key.pem
# TLS_CERT_PATH=apps/api/certs/localhost.pem

# Supabase (NO uses NEXT_PUBLIC_* ni la publishable key aquí)
# SUPABASE_URL = Project URL (https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY = service_role secret (Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# local | supabase (supabase requiere bucket + service_role)
MEDIA_DRIVER=local
UPLOAD_DIR=./uploads
